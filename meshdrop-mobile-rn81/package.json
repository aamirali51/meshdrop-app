{
  "name": "MeshDropMobile",
  "version": "1.0.60",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build:engine": "node scripts/build-engine.js && node scripts/copy-engine-assets.js",
    "prebuild:android": "npm run build:engine",
    "build:android:release": "npm run build:engine && cd android && gradlew.bat assembleRelease",
    "make:release:manifest": "node scripts/make-latest-json.js",
    "logs": "adb -s 192.168.1.4:44075 logcat -v threadtime -s ReactNativeJS:* bare:* MeshDropEngineAssets:* AndroidRuntime:E *:S",
    "logs:raw": "adb -s 192.168.1.4:44075 logcat -v threadtime ReactNativeJS:* bare:* *:S"
  },
  "dependencies": {
    "@mesh/core": "file:../../meshdrop-core",
    "@react-native/new-app-screen": "0.81.4",
    "b4a": "^1.8.1",
    "bare-bundle": "^1.10.0",
    "bare-crypto": "^1.15.3",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "lucide-react-native": "^1.31.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-bare-kit": "^0.13.3",
    "react-native-camera-kit": "^18.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5",
    "sha.js": "^2.4.12",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/eslint-config": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
