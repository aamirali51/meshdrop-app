# Build & output directories
out/
dist/
renderer/dist/
/data/
!renderer/src/data/**
Output/
scratch/

# Electron-builder resources: generated artifacts are ignored, but the
# icons/manifests packaging needs stay committed. build/dev.pfx is a local
# signing certificate and must never be published.
build/*
!build/icon
!build/icon/**
!build/icon.png
!build/icon.ico
!build/icon.icns
!build/entitlements.mac.plist
!build/entrypoint.sh
!build/metainfo.xml
!build/snapcraft.yaml
!build/AppxManifest.xml
!build/installer.nsh

# Local multi-instance testing profile
.p2p-test-profile/
.portable-inspect/

# Node dependencies
node_modules/

# Environment & secret files
.env
.env.local
.env.*.local

# Update-signing key material (private half never leaves this machine).
# Regenerate with: node scripts/update-keygen.js
keys/

# OS system files
.DS_Store
Thumbs.db
desktop.ini

# Editor & IDE settings
.idea/
.vscode/*
!.vscode/extensions.json

# Logs & temp files
*.log
npm-debug.log*

# Agent tooling (not part of the shipped product)
AGENTS.md
.agents/
.opencode/
skills-lock.json

# Internal markdown docs; public-facing docs stay committed
*.md
!README.md
!CONTRIBUTING.md
!TRADEMARK_POLICY.md
!web/README.md

# Graphify Knowledge Graph
graphify-out/

# Release artifacts — generated locally, published to meshdrop-releases
meshdrop-mobile-rn81/MeshDrop-*.apk
meshdrop-mobile-rn81/latest.json

# Bundled ffmpeg/ffprobe for watch-party remux (LGPL). ~535 MB total across
# three platforms — too large to commit. `scripts/fetch-ffmpeg.js` downloads
# and checksum-verifies them; CI runs it before every release build. Without
# them the app still works, it just can't remux (direct-play or refuse).
vendor/ffmpeg/*
!vendor/ffmpeg/README.md
vendor/.ffmpeg-cache/
