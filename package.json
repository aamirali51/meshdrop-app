{
 "name": "meshdrop",
 "productName": "MeshDrop",
 "version": "1.0.52",
 "upgrade": "pear://49x3eqdfgubimdescau51sn7to47c85zkky66mi1kxaxrqpturho",
 "description": "MeshDrop — zero-cloud P2P file sharing. Direct, end-to-end encrypted file transfers between your own devices. No accounts. No cloud.",
 "license": "MIT",
 "author": "Aamir Ali",
 "repository": {
  "type": "git",
  "url": "https://github.com/aamirali51/meshdrop-releases.git"
 },
 "type": "commonjs",
 "main": "electron/main.js",
 "private": true,
 "scripts": {
  "lint": "prettier --check . && lunte",
  "format": "prettier --write . && lunte --fix",
  "test": "node ../meshdrop-core/test-sync-unit.js && node ../meshdrop-core/test.js",
  "test:updater": "node scripts/check-updater-util.js",
  "test:portable": "node scripts/check-portable.js",
  "icons": "node scripts/generate-icons.js",
  "dev:vite": "vite",
  "dev:electron": "wait-on http://localhost:5173 && cross-env PEAR_DEV_SERVER_URL=http://localhost:5173 electron-forge start -- --no-updates",
  "dev": "concurrently --kill-others \"npm run dev:vite\" \"npm run dev:electron\"",
  "dev:p2p": "concurrently --kill-others \"npm run dev:vite\" \"node scripts/dev-p2p.js\"",
  "dev:multi": "concurrently --kill-others -n vite,peer-a,peer-b \"npm run dev:vite\" \"wait-on http://localhost:5173 && cross-env PEAR_DEV_SERVER_URL=http://localhost:5173 electron-forge start -- --no-updates\" \"wait-on http://localhost:5173 && cross-env PEAR_DEV_SERVER_URL=http://localhost:5173 electron-forge start -- --no-updates --test-peer\"",
  "start": "npm run dev",
  "build": "vite build",
  "prebuild:pack": "vite build",
  "build:pack": "electron-builder --publish never",
  "prebuild:release": "vite build",
  "build:release": "electron-builder --publish always",
  "package": "npm run build && electron-forge package",
  "make": "npm run build && electron-forge make",
  "stage": "npm run build && npx pear stage pear://49x3eqdfgubimdescau51sn7to47c85zkky66mi1kxaxrqpturho",
  "release": "npm run build && npx pear stage pear://49x3eqdfgubimdescau51sn7to47c85zkky66mi1kxaxrqpturho && npx pear release pear://49x3eqdfgubimdescau51sn7to47c85zkky66mi1kxaxrqpturho",
  "seed": "npx pear seed pear://49x3eqdfgubimdescau51sn7to47c85zkky66mi1kxaxrqpturho"
 },
